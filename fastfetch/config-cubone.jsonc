{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/cubone-6.png",
        "width": 30,
        "height": 15,
        "padding": {
            "right": 3
        }
    },
"display": {
        "separator": "  ",
        "key": {
            "width": 3
        }
    },  


    "modules": [

        // ───── TITLE ─────
        "break",

        {
            "type": "custom",
            "format": "{##C8A2FF}N 0 1 B C 0 1"
        },

        "break",

        // ───── SYSTEM ─────

        {
            "type": "os",
            "key": "",
            "format": "{2}",
            "keyColor": "#1793D1"
        },

        {
            "type": "kernel",
            "key": "󰌽",
            "keyColor": "#B1B7E1"
        },

        {
            "type": "wm",
            "key": "",
            "format": "{1}",
            "keyColor": "#BD2426"
        },

        {
            "type": "custom",
            "key": "󰓎",
            "format": "Cubone",
            "keyColor": "#E0B86A"
        },

        // ───── TIME ─────

        {
            "type": "datetime",
            "key": "󰥔",
            "format": "{hour-pretty}:{minute-pretty}",
            "keyColor": "#C3B1E1"
        },

        {
            "type": "uptime",
            "key": "󰅐",
            "keyColor": "#DBB1E1"
        },

        "break",

        {
            "type": "command",
            "key": "󰎈",
            "text": "playerctl status >/dev/null 2>&1 && playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | cut -c1-38 || echo 'No music'",
            "keyColor": "#C3B1E1"
        },

        "break",

        // ───── CUBONE COLORS ─────

{
    "type": "custom",
    "format": "{##1793D1}▬▬  {##B1B7E1}▬▬  {##BD2426}▬▬  {##E0B86A}▬▬  {##C3B1E1}▬▬  {##DBB1E1}▬▬"
}
    ]
}